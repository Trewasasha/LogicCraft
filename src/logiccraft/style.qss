/* === Main Window === */
QMainWindow {
    background-color: #F0EFFE;
}

QWidget {
    background-color: #F0EFFE;
    color: #1F1F1F;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* === Toolbar === */
QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E0F8;
    spacing: 6px;
    padding: 4px 8px;
}

QToolBar QToolButton {
    background-color: transparent;
    color: #1F1F1F;
    border: none;
    border-radius: 6px;
    padding: 5px 10px;
}

QToolBar QToolButton:hover {
    background-color: #F3EEFF;
    color: #7C3AED;
}

QToolBar QToolButton:pressed {
    background-color: #EDE9FE;
}

QToolBar::separator {
    width: 1px;
    background-color: #E5E0F8;
    margin: 4px 4px;
}

/* === MenuBar === */
QMenuBar {
    background-color: #FFFFFF;
    color: #1F1F1F;
    border-bottom: 1px solid #E5E0F8;
    padding: 2px 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #F3EEFF;
    color: #7C3AED;
}

/* === Context Menu === */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E5E0F8;
    border-radius: 12px;
    padding: 6px 0px;
}

QMenu::item {
    background-color: transparent;
    color: #1F1F1F;
    padding: 10px 20px;
    margin: 1px 6px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
}

QMenu::item:selected {
    background-color: #F3EEFF;
    color: #7C3AED;
}

QMenu::item:disabled {
    color: #AAAAAA;
}

QMenu::separator {
    height: 1px;
    background-color: #E5E0F8;
    margin: 4px 12px;
}

/* === Dialogs === */
QDialog {
    background-color: #FFFFFF;
    border: 1px solid #E5E0F8;
    border-radius: 12px;
}

QDialog QLabel {
    color: #1F1F1F;
    font-weight: 500;
    margin-bottom: 4px;
    background-color: transparent;
}

QDialog QLineEdit {
    background-color: #F8F6FF;
    border: 1px solid #D4C9F8;
    border-radius: 8px;
    padding: 8px 10px;
    color: #1F1F1F;
    font-size: 13px;
}

QDialog QLineEdit:focus {
    border-color: #7C3AED;
    background-color: #FFFFFF;
}

QDialog QListWidget {
    background-color: #F8F6FF;
    border: 1px solid #D4C9F8;
    border-radius: 8px;
    padding: 4px;
    color: #1F1F1F;
    selection-background-color: #7C3AED;
    selection-color: white;
}

QDialog QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
    margin: 1px;
}

QDialog QListWidget::item:selected {
    background-color: #7C3AED;
    color: white;
}

QDialog QListWidget::item:hover {
    background-color: #F3EEFF;
}

QDialog QPushButton {
    background-color: #7C3AED;
    color: white;
    border: none;
    padding: 9px 20px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    min-width: 90px;
}

QDialog QPushButton:hover {
    background-color: #6D28D9;
}

QDialog QPushButton:pressed {
    background-color: #5B21B6;
}

QDialog QPushButton:disabled {
    background-color: #D4C9F8;
    color: #9B72F5;
}

/* Кнопка Cancel / Secondary */
QDialogButtonBox QPushButton {
    min-width: 90px;
    padding: 9px 20px;
}

QDialogButtonBox QPushButton[text="Cancel"],
QDialogButtonBox QPushButton[text="Отмена"] {
    background-color: #F8F6FF;
    color: #7C3AED;
    border: 1px solid #D4C9F8;
}

QDialogButtonBox QPushButton[text="Cancel"]:hover,
QDialogButtonBox QPushButton[text="Отмена"]:hover {
    background-color: #EDE9FE;
}

/* === StatusBar === */
QStatusBar {
    background-color: #FFFFFF;
    color: #6B7280;
    border-top: 1px solid #E5E0F8;
    font-size: 12px;
}

/* === ScrollBar === */
QScrollBar:vertical {
    background-color: #F0EFFE;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #C4B5FD;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9B72F5;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #F0EFFE;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #C4B5FD;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9B72F5;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* === ComboBox === */
QComboBox {
    background-color: #F8F6FF;
    border: 1px solid #D4C9F8;
    border-radius: 8px;
    padding: 6px 10px;
    color: #1F1F1F;
    font-size: 13px;
}

QComboBox:focus {
    border-color: #7C3AED;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E5E0F8;
    border-radius: 8px;
    selection-background-color: #7C3AED;
    selection-color: white;
}

/* === Welcome Dialog === */
#WelcomeDialog {
    background-color: #F0EFFE;
    border-radius: 20px;
}

#WelcomeTitle {
    font-size: 56px;
    font-weight: 800;
    color: #7C3AED;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

#WelcomeSubtitle {
    font-size: 16px;
    color: #6B7280;
    margin-bottom: 20px;
}

/* Welcome Card - Primary */
#WelcomeCardPrimary {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #8B5CF6, stop:1 #7C3AED);
    border: none;
    border-radius: 16px;
    padding: 20px;
    min-width: 280px;
    min-height: 220px;
}

#WelcomeCardPrimary:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7C3AED, stop:1 #6D28D9);
}

#WelcomeCardPrimary:pressed {
    background: #6D28D9;
}

/* Welcome Card - Secondary */
#WelcomeCardSecondary {
    background-color: #FFFFFF;
    border: 2px solid #E5E0F8;
    border-radius: 16px;
    padding: 20px;
    min-width: 280px;
    min-height: 220px;
}

#WelcomeCardSecondary:hover {
    background-color: #F8F6FF;
    border-color: #C4B5FD;
}

#WelcomeCardSecondary:pressed {
    background-color: #EDE9FE;
}

/* Welcome Card Icons */
#WelcomeCardIconPrimary {
    font-size: 48px;
    color: rgba(255, 255, 255, 200);
}

#WelcomeCardIconSecondary {
    font-size: 48px;
    color: #9B72F5;
}

/* Welcome Card Titles */
#WelcomeCardTitlePrimary {
    font-size: 18px;
    font-weight: 600;
    color: #FFFFFF;
}

#WelcomeCardTitleSecondary {
    font-size: 18px;
    font-weight: 600;
    color: #1F1F1F;
}

/* Welcome Card Subtitles */
#WelcomeCardSubtitlePrimary {
    font-size: 13px;
    color: rgba(255, 255, 255, 180);
}

#WelcomeCardSubtitleSecondary {
    font-size: 13px;
    color: #6B7280;
}

/* Welcome Close Button */
#WelcomeCloseButton {
    background-color: transparent;
    color: #9B72F5;
    font-size: 24px;
    font-weight: bold;
    border: none;
    border-radius: 16px;
}

#WelcomeCloseButton:hover {
    background-color: rgba(155, 114, 245, 0.1);
}
