/* === Main Window === */
QMainWindow {

    background-color: #F0EFFE;
}

QWidget {
    background-color: #F0EFFE;
    color: #1F1F1F;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* === Toolbar === */
QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E0F8;
    spacing: 6px;
    padding: 4px 8px;
}

QToolBar QToolButton {
    background-color: transparent;
    color: #1F1F1F;
    border: none;
    border-radius: 6px;
    padding: 5px 10px;
}

QToolBar QToolButton:hover {
    background-color: #F3EEFF;
    color: #7C3AED;
}

QToolBar QToolButton:pressed {
    background-color: #EDE9FE;
}

QToolBar::separator {
    width: 1px;
    background-color: #E5E0F8;
    margin: 4px 4px;
}

/* === MenuBar === */
QMenuBar {
    background-color: #FFFFFF;
    color: #1F1F1F;
    border-bottom: 1px solid #E5E0F8;
    padding: 2px 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #F3EEFF;
    color: #7C3AED;
}

/* === Context Menu === */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E5E0F8;
    border-radius: 12px;
    padding: 6px 0px;
    min-width: 180px;
}

QMenu::item {
    background-color: transparent;
    color: #1F1F1F;
    padding: 10px 18px;
    margin: 1px 6px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
}

QMenu::item:selected {
    background-color: #F3EEFF;
    color: #7C3AED;
}

QMenu::item:disabled {
    color: #AAAAAA;
}

QMenu::separator {
    height: 1px;
    background-color: #E5E0F8;
    margin: 4px 12px;
}

/* === Dialogs === */
QDialog {
    background-color: #FFFFFF;
    border: 1px solid #E5E0F8;
    border-radius: 12px;
}

QDialog QLabel {
    color: #1F1F1F;
    font-weight: 500;
    margin-bottom: 4px;
    background-color: transparent;
}

QDialog QLineEdit {
    background-color: #F8F6FF;
    border: 1px solid #D4C9F8;
    border-radius: 8px;
    padding: 8px 10px;
    color: #1F1F1F;
    font-size: 13px;
}

QDialog QLineEdit:focus {
    border-color: #7C3AED;
    background-color: #FFFFFF;
}

QDialog QListWidget {
    background-color: #F8F6FF;
    border: 1px solid #D4C9F8;
    border-radius: 8px;
    padding: 4px;
    color: #1F1F1F;
    selection-background-color: #7C3AED;
    selection-color: white;
}

QDialog QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
    margin: 1px;
}

QDialog QListWidget::item:selected {
    background-color: #7C3AED;
    color: white;
}

QDialog QListWidget::item:hover {
    background-color: #F3EEFF;
}

QDialog QPushButton {
    background-color: #7C3AED;
    color: white;
    border: none;
    padding: 9px 20px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    min-width: 90px;
}

QDialog QPushButton:hover {
    background-color: #6D28D9;
}

QDialog QPushButton:pressed {
    background-color: #5B21B6;
}

QDialog QPushButton:disabled {
    background-color: #D4C9F8;
    color: #9B72F5;
}

/* Кнопка Cancel / Secondary */
QDialogButtonBox QPushButton {
    min-width: 90px;
    padding: 9px 20px;
}

QDialogButtonBox QPushButton[text="Cancel"],
QDialogButtonBox QPushButton[text="Отмена"] {
    background-color: #F8F6FF;
    color: #7C3AED;
    border: 1px solid #D4C9F8;
}

QDialogButtonBox QPushButton[text="Cancel"]:hover,
QDialogButtonBox QPushButton[text="Отмена"]:hover {
    background-color: #EDE9FE;
}

/* === StatusBar === */
QStatusBar {
    background-color: #FFFFFF;
    color: #6B7280;
    border-top: 1px solid #E5E0F8;
    font-size: 12px;
}

/* === ScrollBar === */
QScrollBar:vertical {
    background-color: #F0EFFE;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #C4B5FD;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9B72F5;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #F0EFFE;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #C4B5FD;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9B72F5;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* === ComboBox === */
QComboBox {
    background-color: #F8F6FF;
    border: 1px solid #D4C9F8;
    border-radius: 8px;
    padding: 6px 10px;
    color: #1F1F1F;
    font-size: 13px;
}

QComboBox:focus {
    border-color: #7C3AED;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E5E0F8;
    border-radius: 8px;
    selection-background-color: #7C3AED;
    selection-color: white;
}

/* === Welcome Dialog === */
#WelcomeDialog {
    background-color: #F0EFFE;
    border-radius: 20px;
}

#WelcomeTitle {
    font-size: 56px;
    font-weight: 800;
    color: #7C3AED;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

#WelcomeSubtitle {
    font-size: 16px;
    color: #6B7280;
    margin-bottom: 20px;
}

/* Welcome Card - Primary */
#WelcomeCardPrimary {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #8B5CF6, stop:1 #7C3AED);
    border: none;
    border-radius: 16px;
    padding: 20px;
}

#WelcomeCardPrimary:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7C3AED, stop:1 #6D28D9);
}

#WelcomeCardPrimary:pressed {
    background: #6D28D9;
}

/* Welcome Card - Secondary */
#WelcomeCardSecondary {
    background-color: #FFFFFF;
    border: 2px solid #E5E0F8;
    border-radius: 16px;
    padding: 20px;
}

#WelcomeCardSecondary:hover {
    background-color: #F8F6FF;
    border-color: #C4B5FD;
}

#WelcomeCardSecondary:pressed {
    background-color: #EDE9FE;
}

/* Welcome Card Icons */
#WelcomeCardIconPrimary {
    font-size: 48px;
    color: rgba(255, 255, 255, 200);
}

#WelcomeCardIconSecondary {
    font-size: 48px;
    color: #9B72F5;
}

/* Welcome Card Titles */
#WelcomeCardTitlePrimary {
    font-size: 18px;
    font-weight: 600;
    color: #FFFFFF;
}

#WelcomeCardTitleSecondary {
    font-size: 18px;
    font-weight: 600;
    color: #1F1F1F;
}

/* Welcome Card Subtitles */
#WelcomeCardSubtitlePrimary {
    font-size: 13px;
    color: rgba(255, 255, 255, 180);
}

#WelcomeCardSubtitleSecondary {
    font-size: 13px;
    color: #6B7280;
}

/* Welcome Close Button */
#WelcomeCloseButton {
    background-color: transparent;
    color: #9B72F5;
    font-size: 24px;
    font-weight: bold;
    border: none;
    border-radius: 16px;
}

#WelcomeCloseButton:hover {
    background-color: rgba(155, 114, 245, 0.1);
}

/* === Toolbox Panel === */
#ToolboxPanel {
    background-color: #FFFFFF;
    border-right: 1px solid #E5E0F8;
}

#ToolboxTitle {
    font-size: 13px;
    font-weight: 700;
    color: #1F1F1F;
    padding-bottom: 4px;
}

#ToolboxSectionTitle {
    font-size: 11px;
    font-weight: 600;
    color: #9B72F5;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 0px 2px 0px;
}

#ToolboxButton {
    background-color: transparent;
    color: #1F1F1F;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
    text-align: left;
}

#ToolboxButton:hover {
    background-color: #F3EEFF;
    border-color: #E5E0F8;
    color: #7C3AED;
}

#ToolboxButton:pressed {
    background-color: #EDE9FE;
}

#ToolboxDivider {
    color: #E5E0F8;
    margin: 4px 0px;
}

/* === Properties Panel === */
#PropertiesPanel {
    background-color: #FFFFFF;
    border-left: 1px solid #E5E0F8;
}

#PropertiesPanelTitle {
    font-size: 13px;
    font-weight: 700;
    color: #1F1F1F;
    padding: 12px 12px 8px 12px;
    border-bottom: 1px solid #E5E0F8;
    background-color: #FFFFFF;
}

#PropertiesScroll {
    background-color: #FAFAFE;
}

#PropertiesContent {
    background-color: #FAFAFE;
}

#PropertiesEmptyLabel {
    color: #9B72F5;
    font-size: 13px;
    padding: 40px 20px;
}

#PropertiesSectionLabel {
    font-size: 11px;
    font-weight: 600;
    color: #9B72F5;
    text-transform: uppercase;
    letter-spacing: 1px;
}

#PropertiesInput {
    background-color: #FFFFFF;
    border: 1px solid #D4C9F8;
    border-radius: 8px;
    padding: 6px 10px;
    color: #1F1F1F;
    font-size: 13px;
}

#PropertiesInput:focus {
    border-color: #7C3AED;
}

#PropertiesCombo {
    background-color: #FFFFFF;
    border: 1px solid #D4C9F8;
    border-radius: 8px;
    padding: 5px 10px;
    color: #1F1F1F;
    font-size: 13px;
}

#PropertiesList {
    background-color: #FFFFFF;
    border: 1px solid #E5E0F8;
    border-radius: 8px;
    font-size: 12px;
    color: #1F1F1F;
}

#PropertiesList::item {
    padding: 4px 6px;
    border-radius: 4px;
}

#PropertiesList::item:selected {
    background-color: #EDE9FE;
    color: #7C3AED;
}

#PropertiesSmallButton {
    background-color: #F3EEFF;
    color: #7C3AED;
    border: none;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 500;
}

#PropertiesSmallButton:hover {
    background-color: #EDE9FE;
}

#PropertiesSmallButtonDanger {
    background-color: #FEF2F2;
    color: #EF4444;
    border: none;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 500;
}

#PropertiesSmallButtonDanger:hover {
    background-color: #FEE2E2;
}

#PropertiesDeleteButton {
    background-color: #FEF2F2;
    color: #EF4444;
    border: 1px solid #FECACA;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 500;
    margin-top: 8px;
}

#PropertiesDeleteButton:hover {
    background-color: #FEE2E2;
}

/* === QDockWidget === */
QDockWidget {
    font-size: 13px;
    font-weight: 600;
    color: #1F1F1F;
    titlebar-close-icon: none;
}

QDockWidget::title {
    background-color: #F8F6FF;
    padding: 6px 10px;
    border-bottom: 1px solid #E5E0F8;
}

/* === Zoom Controls === */
#ZoomButton {
    background-color: transparent;
    color: #7C3AED;
    border: 1px solid #E5E0F8;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
    padding: 0px;
}

#ZoomButton:hover {
    background-color: #F3EEFF;
    border-color: #C4B5FD;
}

#ZoomButton:pressed {
    background-color: #EDE9FE;
}

#ZoomLabel {
    color: #6B7280;
    font-size: 12px;
    text-align: center;
}

#StatusBarStats {
    color: #6B7280;
    font-size: 12px;
    padding-right: 12px;
}

/* ─── Project Type Dialog ─────────────────────────────────────────────── */

#ProjectTypeDialog {
    background-color: #FFFFFF;
}

#ProjectTypeDialogTitle {
    font-size: 28px;
    font-weight: 700;
    color: #1F1F1F;
}

#ProjectTypeDialogSubtitle {
    font-size: 14px;
    color: #666666;
}

#ProjectTypeScrollArea {
    border: none;
    background-color: transparent;
}

#DiagramTypeCard {
    background-color: #FFFFFF;
    border: 2px solid #E5E0F8;
    border-radius: 12px;
    text-align: left;
}

#DiagramTypeCard:hover {
    background-color: #F9F7FF;
    border-color: #7C3AED;
}

#DiagramTypeCard:pressed {
    background-color: #F3EEFF;
}

#DiagramTypeCardDisabled {
    background-color: #F9F9F9;
    border: 2px solid #E0E0E0;
    border-radius: 12px;
    text-align: left;
}

#DiagramTypeTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1F1F1F;
}

#DiagramTypeDescription {
    font-size: 13px;
    color: #666666;
    line-height: 1.4;
}

#ComingSoonBadge {
    background-color: #FFF4E6;
    color: #F59E0B;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}

#SecondaryButton {
    background-color: transparent;
    color: #7C3AED;
    border: 2px solid #7C3AED;
    border-radius: 20px;
    padding: 8px 24px;
    font-weight: 600;
    font-size: 14px;
}

#SecondaryButton:hover {
    background-color: #F3EEFF;
}

#SecondaryButton:pressed {
    background-color: #E9D5FF;
}

/* ─── New Project Dialog (One-page) ───────────────────────────────────── */

#NewProjectDialog {
    background-color: #FFFFFF;
}

#NewProjectDialogTitle {
    font-size: 24px;
    font-weight: 700;
    color: #1F1F1F;
    margin-bottom: 10px;
}

#NewProjectScrollArea {
    border: none;
    background-color: transparent;
}

#ProjectGroupBox {
    font-size: 14px;
    font-weight: 600;
    color: #1F1F1F;
    border: 2px solid #E5E0F8;
    border-radius: 8px;
    padding: 15px;
    margin-top: 10px;
}

#ProjectGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    background-color: #FFFFFF;
}

#ProjectFieldLabel {
    font-size: 13px;
    font-weight: 500;
    color: #333333;
}

#ProjectInput {
    background-color: #FFFFFF;
    border: 1.5px solid #D4C9F8;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    color: #1F1F1F;
}

#ProjectInput:focus {
    border-color: #7C3AED;
    background-color: #F9F7FF;
}

#ProjectComboBox {
    background-color: #FFFFFF;
    border: 1.5px solid #D4C9F8;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    color: #1F1F1F;
}

#ProjectComboBox:hover {
    border-color: #7C3AED;
}

#ProjectComboBox::drop-down {
    border: none;
    width: 20px;
}

#ProjectComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #7C3AED;
    margin-right: 5px;
}

#BrowseButton {
    background-color: #F3EEFF;
    border: 1.5px solid #7C3AED;
    border-radius: 6px;
}

#BrowseButton:hover {
    background-color: #E9D5FF;
}

#BrowseButton:pressed {
    background-color: #DDD6FE;
}

#ProjectRadio {
    font-size: 13px;
    color: #333333;
    spacing: 8px;
}

#ProjectRadio::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #D4C9F8;
    background-color: #FFFFFF;
}

#ProjectRadio::indicator:checked {
    background-color: #7C3AED;
    border-color: #7C3AED;
}

#ProjectCheckBox {
    font-size: 13px;
    color: #333333;
    spacing: 8px;
}

#ProjectCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #D4C9F8;
    background-color: #FFFFFF;
}

#ProjectCheckBox::indicator:checked {
    background-color: #7C3AED;
    border-color: #7C3AED;
    image: url(none);
}

#DiagramTypeButton {
    background-color: #FFFFFF;
    border: 2px solid #E5E0F8;
    border-radius: 8px;
    text-align: center;
}

#DiagramTypeButton:hover {
    background-color: #F9F7FF;
    border-color: #7C3AED;
}

#DiagramTypeButton:checked {
    background-color: #F3EEFF;
    border-color: #7C3AED;
    border-width: 3px;
}

#DiagramTypeButtonDisabled {
    background-color: #F5F5F5;
    border: 2px solid #E0E0E0;
    border-radius: 8px;
    text-align: center;
}

#DiagramTypeIcon {
    font-size: 28px;
}

#DiagramTypeLabel {
    font-size: 11px;
    font-weight: 500;
    color: #666666;
}

#PrimaryButton {
    background-color: #7C3AED;
    color: white;
    border: 2px solid #7C3AED;
    border-radius: 20px;
    padding: 8px 24px;
    font-weight: 600;
    font-size: 14px;
}

#PrimaryButton:hover {
    background-color: #6D28D9;
    border-color: #6D28D9;
}

#PrimaryButton:pressed {
    background-color: #5B21B6;
}
